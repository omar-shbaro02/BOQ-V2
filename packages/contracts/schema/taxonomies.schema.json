{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vai.local/schemas/taxonomies.schema.json",
  "title": "VAI Taxonomy Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomies"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "taxonomies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    }
  }
}

