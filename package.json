{
  "name": "vai-construction-control",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "verify:r10": "python scripts/verify_r10.py",
    "test:browser": "playwright test",
    "test:browser:oidc": "playwright test --config=playwright.oidc.config.ts",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:web": "npm run dev --workspace @vai/web",
    "build:web": "npm run build --workspace @vai/web",
    "lint:web": "npm run lint --workspace @vai/web",
    "typecheck:web": "npm run typecheck --workspace @vai/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "update-browserslist-db": "1.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
